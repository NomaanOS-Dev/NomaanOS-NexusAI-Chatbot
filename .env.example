# NomaanOS Nexus AI — Production & Deployment Environment Configuration Template
# Copy this file to .env and configure all secrets before deploying:
# cp .env.example .env

# ==============================================================================
# 1. Runtime Environment
# ==============================================================================
NODE_ENV=production

# Core API Server Configuration
API_PORT=4001
API_HOST=0.0.0.0
LOG_LEVEL=info

# ==============================================================================
# 2. PostgreSQL & pgvector Database Configuration
# ==============================================================================
# Port 5434 is used by default in docker-compose
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=nomaanos_nexus_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=3000

# Full Connection URL (Derived automatically if omitted)
DATABASE_URL=postgresql://postgres:CHANGE_ME_IN_PRODUCTION@localhost:5434/nomaanos_nexus_ai

# Vector Embedding Configuration
VECTOR_DIMENSION=768
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# 3. Authentication & Session Security
# ==============================================================================
# Provide a cryptographically secure 64-character random secret:
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET_FOR_PRODUCTION
SESSION_COOKIE_NAME=Nomaan_NexusAI_Session
SESSION_EXPIRATION_DAYS=7

# ==============================================================================
# 4. Storage & Ingestion Limits
# ==============================================================================
STORAGE_BASE_DIR=storage
MAX_UPLOAD_FILE_BYTES=15728640
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.txt,.html,.htm,.json,.yaml,.yml,.docx

# Background Ingestion Worker Configuration
WORKER_POLL_INTERVAL_MS=3000
WORKER_LEASE_DURATION_SECONDS=60
WORKER_MAX_JOB_ATTEMPTS=3

# ==============================================================================
# 5. Inference & AI Model Routing Configuration
# ==============================================================================
# Options: 'ollama' | 'local_deterministic' | 'openai' | 'anthropic'
INFERENCE_PROVIDER=ollama
LOCAL_INFERENCE_ONLY=true

# Local Ollama Configuration (Default local engine)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_MS=30000

# Model Routing Policy: 'local-only' | 'cloud-preferred' | 'hybrid' | 'cloud-only'
MODEL_ROUTING_POLICY=local-only

# Optional Cloud Providers (Only required when MODEL_ROUTING_POLICY allows cloud)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TIMEOUT_MS=30000

RATE_LIMIT_RETRY_ATTEMPTS=2
RATE_LIMIT_BASE_DELAY_MS=500
HYBRID_COMPLEXITY_TOKEN_THRESHOLD=300

# ==============================================================================
# 6. Air-Gapped & Offline Deployment
# ==============================================================================
OFFLINE_MODE=true
REMOTE_DATA_ENABLED=false
OFFLINE_STORAGE_DIR=storage/offline_packages
